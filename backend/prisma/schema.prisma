// Projeto Pandora — schema base (spec 001).
// SEM model de negócio nesta spec. As entidades entram nas specs 002+.
// Convenções para models futuros (ver docs/001-bootstrap-projeto.md):
//   - PK: `id String @id @db.Uuid` gerado na aplicação via EntidadeId.novo() (UUID v7)
//   - Auditoria: `criadoEm DateTime @default(now()) @db.Timestamptz` +
//                `atualizadoEm DateTime @updatedAt @db.Timestamptz`
//   - Instantes sempre @db.Timestamptz (UTC)
//   - IDs de origem NUNCA como PK — tabelas `<entidade>_origem_ref`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================================
// RBAC (spec 004) — primeira migração de negócio do projeto.
// `perfil` e `usuario` nascem com PK UUID v7 gerada na aplicação (EntidadeId.novo()).
// Permissão NÃO é tabela: o catálogo é código (src/auth/rbac/catalogo.ts);
// `perfil_permissao.permissao` guarda o id `recurso:acao` validado contra o catálogo.
// `rbac_audit` é append-only (a aplicação nunca faz UPDATE/DELETE nela).
// ============================================================================

model Usuario {
  id               String   @id @db.Uuid
  nome             String
  email            String
  emailNormalizado String   @unique @map("email_normalizado")
  criadoEm         DateTime @default(now()) @map("criado_em") @db.Timestamptz(6)
  atualizadoEm     DateTime @updatedAt @map("atualizado_em") @db.Timestamptz(6)

  perfis            UsuarioPerfil[]
  equipesComoMembro EquipeMembro[]

  @@map("usuario")
}

model Perfil {
  id              String   @id @db.Uuid
  nome            String
  nomeNormalizado String   @unique @map("nome_normalizado")
  deSistema       Boolean  @default(false) @map("de_sistema")
  criadoEm        DateTime @default(now()) @map("criado_em") @db.Timestamptz(6)
  atualizadoEm    DateTime @updatedAt @map("atualizado_em") @db.Timestamptz(6)

  permissoes PerfilPermissao[]
  usuarios   UsuarioPerfil[]

  @@map("perfil")
}

model PerfilPermissao {
  perfilId  String @map("perfil_id") @db.Uuid
  permissao String

  perfil Perfil @relation(fields: [perfilId], references: [id], onDelete: Cascade)

  @@id([perfilId, permissao])
  @@map("perfil_permissao")
}

model UsuarioPerfil {
  usuarioId String   @map("usuario_id") @db.Uuid
  perfilId  String   @map("perfil_id") @db.Uuid
  criadoEm  DateTime @default(now()) @map("criado_em") @db.Timestamptz(6)

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  perfil  Perfil  @relation(fields: [perfilId], references: [id], onDelete: Restrict)

  @@id([usuarioId, perfilId])
  @@map("usuario_perfil")
}

model RbacAudit {
  id            String   @id @db.Uuid
  autor         String
  quando        DateTime @db.Timestamptz(6)
  entidade      String
  entidadeId    String   @map("entidade_id") @db.Uuid
  campo         String
  valorAnterior Json?    @map("valor_anterior")
  valorNovo     Json?    @map("valor_novo")
  motivo        String
  origem        String
  criadoEm      DateTime @default(now()) @map("criado_em") @db.Timestamptz(6)

  @@index([entidade, entidadeId])
  @@map("rbac_audit")
}

// ============================================================================
// clientes (spec 005) — 2ª migração de negócio. `pessoa` (ex-`Cliente`), `conta`
// (household/empresa), contatos com primário+secundários, refs de origem
// (id de origem NUNCA como PK — só em `pessoa_origem_ref`), merge reversível
// (snapshot + proveniência por linha), `nota_reconciliacao` e `clientes_audit`
// (forma canônica do core, append-only, simétrico ao `rbac_audit`).
// `conta` NÃO referencia `contrato` (regra de negócio inviolável #3).
// ============================================================================

enum PlataformaOrigem {
  TMB
  ASAAS_PRD
  ASAAS_SVC
  GURU_PRD
  GURU_SVC
  HOTMART_PRD
  HOTMART_SVC
}

enum PessoaTipo {
  FISICA
  JURIDICA
  DESCONHECIDO
}

enum ContaTipo {
  HOUSEHOLD
  EMPRESA
}

enum DocumentoTipo {
  CPF
  CNPJ
}

enum MergeEstado {
  ATIVO
  DESFEITO
}

model Pessoa {
  id               String     @id @db.Uuid
  tipo             PessoaTipo @default(DESCONHECIDO)
  nome             String
  contaId          String?    @map("conta_id") @db.Uuid
  pseudonimizadaEm DateTime?  @map("pseudonimizada_em") @db.Timestamptz(6)
  mergedPara       String?    @map("merged_para") @db.Uuid
  criadoEm         DateTime   @default(now()) @map("criado_em") @db.Timestamptz(6)
  atualizadoEm     DateTime   @updatedAt @map("atualizado_em") @db.Timestamptz(6)

  conta        Conta?            @relation(fields: [contaId], references: [id], onDelete: SetNull)
  sobrevivente Pessoa?           @relation("PessoaMerge", fields: [mergedPara], references: [id], onDelete: Restrict)
  absorvidas   Pessoa[]          @relation("PessoaMerge")
  emails       PessoaEmail[]
  telefones    PessoaTelefone[]
  documentos   PessoaDocumento[]
  enderecos    PessoaEndereco[]
  origemRefs   PessoaOrigemRef[]

  @@index([contaId])
  @@index([mergedPara])
  @@map("pessoa")
}

model Conta {
  id           String    @id @db.Uuid
  tipo         ContaTipo
  nome         String
  mergedPara   String?   @map("merged_para") @db.Uuid
  criadoEm     DateTime  @default(now()) @map("criado_em") @db.Timestamptz(6)
  atualizadoEm DateTime  @updatedAt @map("atualizado_em") @db.Timestamptz(6)

  sobrevivente Conta?   @relation("ContaMerge", fields: [mergedPara], references: [id], onDelete: Restrict)
  absorvidas   Conta[]  @relation("ContaMerge")
  pessoas      Pessoa[]

  @@index([mergedPara])
  @@map("conta")
}

model PessoaEmail {
  id            String    @id @db.Uuid
  pessoaId      String    @map("pessoa_id") @db.Uuid
  valor         String
  primario      Boolean   @default(false)
  curado        Boolean   @default(false)
  rebaixadoEm   DateTime? @map("rebaixado_em") @db.Timestamptz(6)
  origemMergeId String?   @map("origem_merge_id") @db.Uuid
  criadoEm      DateTime  @default(now()) @map("criado_em") @db.Timestamptz(6)
  atualizadoEm  DateTime  @updatedAt @map("atualizado_em") @db.Timestamptz(6)

  pessoa Pessoa @relation(fields: [pessoaId], references: [id], onDelete: Cascade)

  @@unique([pessoaId, valor])
  @@index([valor])
  @@map("pessoa_email")
}

model PessoaTelefone {
  id            String    @id @db.Uuid
  pessoaId      String    @map("pessoa_id") @db.Uuid
  valor         String
  primario      Boolean   @default(false)
  curado        Boolean   @default(false)
  rebaixadoEm   DateTime? @map("rebaixado_em") @db.Timestamptz(6)
  origemMergeId String?   @map("origem_merge_id") @db.Uuid
  criadoEm      DateTime  @default(now()) @map("criado_em") @db.Timestamptz(6)
  atualizadoEm  DateTime  @updatedAt @map("atualizado_em") @db.Timestamptz(6)

  pessoa Pessoa @relation(fields: [pessoaId], references: [id], onDelete: Cascade)

  @@unique([pessoaId, valor])
  @@index([valor])
  @@map("pessoa_telefone")
}

model PessoaDocumento {
  id            String        @id @db.Uuid
  pessoaId      String        @map("pessoa_id") @db.Uuid
  tipo          DocumentoTipo
  valor         String
  curado        Boolean       @default(false)
  origemMergeId String?       @map("origem_merge_id") @db.Uuid
  criadoEm      DateTime      @default(now()) @map("criado_em") @db.Timestamptz(6)
  atualizadoEm  DateTime      @updatedAt @map("atualizado_em") @db.Timestamptz(6)

  pessoa Pessoa @relation(fields: [pessoaId], references: [id], onDelete: Cascade)

  @@unique([tipo, valor])
  @@index([pessoaId])
  @@map("pessoa_documento")
}

model PessoaEndereco {
  id            String   @id @db.Uuid
  pessoaId      String   @map("pessoa_id") @db.Uuid
  logradouro    String
  numero        String?
  complemento   String?
  bairro        String?
  cidade        String?
  uf            String?
  cep           String?
  pais          String   @default("BR")
  curado        Boolean  @default(false)
  origemMergeId String?  @map("origem_merge_id") @db.Uuid
  criadoEm      DateTime @default(now()) @map("criado_em") @db.Timestamptz(6)
  atualizadoEm  DateTime @updatedAt @map("atualizado_em") @db.Timestamptz(6)

  pessoa Pessoa @relation(fields: [pessoaId], references: [id], onDelete: Cascade)

  @@index([pessoaId])
  @@map("pessoa_endereco")
}

model PessoaOrigemRef {
  id               String           @id @db.Uuid
  pessoaId         String           @map("pessoa_id") @db.Uuid
  plataformaOrigem PlataformaOrigem @map("plataforma_origem")
  tipoRef          String           @map("tipo_ref")
  valorRef         String           @map("valor_ref")
  origemMergeId    String?          @map("origem_merge_id") @db.Uuid
  criadoEm         DateTime         @default(now()) @map("criado_em") @db.Timestamptz(6)

  pessoa Pessoa @relation(fields: [pessoaId], references: [id], onDelete: Cascade)

  @@unique([plataformaOrigem, tipoRef, valorRef])
  @@index([pessoaId])
  @@index([plataformaOrigem])
  @@map("pessoa_origem_ref")
}

model MergePessoa {
  id             String      @id @db.Uuid
  sobreviventeId String      @map("sobrevivente_id") @db.Uuid
  absorvidaId    String      @map("absorvida_id") @db.Uuid
  autor          String
  quando         DateTime    @db.Timestamptz(6)
  snapshot       Json
  estado         MergeEstado @default(ATIVO)
  desfeitoPor    String?     @map("desfeito_por")
  desfeitoEm     DateTime?   @map("desfeito_em") @db.Timestamptz(6)
  criadoEm       DateTime    @default(now()) @map("criado_em") @db.Timestamptz(6)

  @@index([sobreviventeId])
  @@index([absorvidaId])
  @@map("merge_pessoa")
}

model MergeConta {
  id             String      @id @db.Uuid
  sobreviventeId String      @map("sobrevivente_id") @db.Uuid
  absorvidaId    String      @map("absorvida_id") @db.Uuid
  autor          String
  quando         DateTime    @db.Timestamptz(6)
  snapshot       Json
  estado         MergeEstado @default(ATIVO)
  desfeitoPor    String?     @map("desfeito_por")
  desfeitoEm     DateTime?   @map("desfeito_em") @db.Timestamptz(6)
  criadoEm       DateTime    @default(now()) @map("criado_em") @db.Timestamptz(6)

  @@index([sobreviventeId])
  @@index([absorvidaId])
  @@map("merge_conta")
}

model NotaReconciliacao {
  id            String   @id @db.Uuid
  entidade      String
  entidadeId    String   @map("entidade_id") @db.Uuid
  origem        String
  campo         String
  valorCurado   Json?    @map("valor_curado")
  valorDerivado Json?    @map("valor_derivado")
  motivo        String
  criadoEm      DateTime @default(now()) @map("criado_em") @db.Timestamptz(6)

  @@index([entidade, entidadeId])
  @@map("nota_reconciliacao")
}

model ClientesAudit {
  id            String   @id @db.Uuid
  autor         String
  quando        DateTime @db.Timestamptz(6)
  entidade      String
  entidadeId    String   @map("entidade_id") @db.Uuid
  campo         String
  valorAnterior Json?    @map("valor_anterior")
  valorNovo     Json?    @map("valor_novo")
  motivo        String
  origem        String
  criadoEm      DateTime @default(now()) @map("criado_em") @db.Timestamptz(6)

  @@index([entidade, entidadeId])
  @@map("clientes_audit")
}

// ============================================================================
// ingestao (spec 006) — 4ª migração de negócio. Event log imutável
// `evento_origem` (dedup por (plataforma_origem, id_origem, hash)), registro por
// etapa `evento_etapa` (pipeline canônico da visão 5.3; etapas 2–6 são no-op
// nesta spec) e `ingestao_audit` (forma canônica do core, append-only — grava só
// o reprocessamento manual). Ver docs/006-evento-origem-worker.md.
// `evento_origem` é imutável: a aplicação nunca faz UPDATE de payload_bruto/
// hash/plataforma_origem/id_origem/recebido_em.
// ============================================================================

enum EventoOrigemStatus {
  pendente
  ok
  erro
  revisar
}

enum EventoEtapaStatus {
  pendente
  processando
  ok
  erro
  bloqueada
  pulada
}

enum EtapaIngestao {
  REGISTRAR
  CLASSIFICAR
  RESOLVER_PESSOA
  UPSERT_TRANSACAO
  RESOLVER_VINCULO
  RESOLVER_OFERTA
  PROJETAR_CONTRATO
}

enum Classificacao {
  VENDA_PROPRIA
  VENDA_AFILIADA
  COBRANCA_TERCEIRIZADA
  REEMBOLSO
  RECORRENCIA
  OUTRO
  DESCONHECIDO
}

model EventoOrigem {
  id               String             @id @db.Uuid
  plataformaOrigem PlataformaOrigem   @map("plataforma_origem")
  idOrigem         String             @map("id_origem")
  tipoOrigem       String             @map("tipo_origem")
  payloadBruto     Json               @map("payload_bruto")
  eventoCanonico   Json?              @map("evento_canonico")
  hash             String
  recebidoEm       DateTime           @map("recebido_em") @db.Timestamptz(6)
  ultimoRecebidoEm DateTime           @map("ultimo_recebido_em") @db.Timestamptz(6)
  reentregas       Int                @default(0)
  status           EventoOrigemStatus @default(pendente)
  classificacao    Classificacao?
  erroDetalhe      String?            @map("erro_detalhe")
  criadoEm         DateTime           @default(now()) @map("criado_em") @db.Timestamptz(6)
  atualizadoEm     DateTime           @updatedAt @map("atualizado_em") @db.Timestamptz(6)

  etapas EventoEtapa[]

  @@unique([plataformaOrigem, idOrigem, hash], name: "evento_origem_chave_natural")
  @@index([status, recebidoEm])
  @@index([plataformaOrigem])
  @@index([classificacao])
  @@map("evento_origem")
}

model EventoEtapa {
  id             String            @id @db.Uuid
  eventoOrigemId String            @map("evento_origem_id") @db.Uuid
  etapa          EtapaIngestao
  status         EventoEtapaStatus @default(pendente)
  resultado      Json?
  erroDetalhe    String?           @map("erro_detalhe")
  tentativas     Int               @default(0)
  executadoEm    DateTime?         @map("executado_em") @db.Timestamptz(6)
  criadoEm       DateTime          @default(now()) @map("criado_em") @db.Timestamptz(6)
  atualizadoEm   DateTime          @updatedAt @map("atualizado_em") @db.Timestamptz(6)

  evento EventoOrigem @relation(fields: [eventoOrigemId], references: [id], onDelete: Restrict)

  @@unique([eventoOrigemId, etapa])
  @@index([status])
  @@map("evento_etapa")
}

model IngestaoAudit {
  id            String   @id @db.Uuid
  autor         String
  quando        DateTime @db.Timestamptz(6)
  entidade      String
  entidadeId    String   @map("entidade_id") @db.Uuid
  campo         String
  valorAnterior Json?    @map("valor_anterior")
  valorNovo     Json?    @map("valor_novo")
  motivo        String
  origem        String
  criadoEm      DateTime @default(now()) @map("criado_em") @db.Timestamptz(6)

  @@index([entidade, entidadeId])
  @@map("ingestao_audit")
}

// ============================================================================
// crm — Administração do CRM (spec 007) — 5ª migração de negócio.
// Times/squads (`equipe` + `equipe_membro`, FK -> `usuario` da 004; ≤1 vínculo
// ativo por par via índice único PARCIAL `WHERE saiu_em IS NULL`, aplicado no
// migration.sql), expediente (`janela_atendimento` + `feriado`; hora como Int
// minutos locais America/Sao_Paulo; sem cruzar meia-noite — CL-02), registro de
// integrações (`integracao`; segredo cifrado em repouso OU só-hash p/ API key
// interna; NUNCA volta em leitura — só `segredo_ultimos4` p/ a máscara) e a
// trilha `crm_admin_audit` (forma canônica do core, append-only, só delta real,
// nunca contém segredo). Ver docs/007-crm-administracao.md.
// ============================================================================

enum EquipeTipo {
  COMERCIAL
  ATENDIMENTO
  CS
}

enum PapelEquipe {
  LIDER
  MEMBRO
}

enum IntegracaoTipo {
  API_KEY
  WEBHOOK
  CONEXAO_INTERNA
}

enum IntegracaoAlvo {
  FINANCEIRO
  MARKETING
  CENTRAL
  EXTERNO
}

model Equipe {
  id           String     @id @db.Uuid
  nome         String
  descricao    String?
  tipo         EquipeTipo
  ativo        Boolean    @default(true)
  criadoEm     DateTime   @default(now()) @map("criado_em") @db.Timestamptz(6)
  atualizadoEm DateTime   @updatedAt @map("atualizado_em") @db.Timestamptz(6)

  membros  EquipeMembro[]
  janelas  JanelaAtendimento[]
  feriados Feriado[]

  @@index([ativo])
  @@map("equipe")
}

model EquipeMembro {
  id           String      @id @db.Uuid
  equipeId     String      @map("equipe_id") @db.Uuid
  usuarioId    String      @map("usuario_id") @db.Uuid
  papel        PapelEquipe
  entrouEm     DateTime    @map("entrou_em") @db.Timestamptz(6)
  saiuEm       DateTime?   @map("saiu_em") @db.Timestamptz(6)
  criadoEm     DateTime    @default(now()) @map("criado_em") @db.Timestamptz(6)
  atualizadoEm DateTime    @updatedAt @map("atualizado_em") @db.Timestamptz(6)

  equipe  Equipe  @relation(fields: [equipeId], references: [id], onDelete: Restrict)
  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Restrict)

  // O índice único PARCIAL `(equipe_id, usuario_id) WHERE saiu_em IS NULL`
  // (≤1 vínculo ativo por par; histórico de reentrada permitido) é criado no
  // migration.sql — o Prisma não expressa índice parcial no schema.
  @@index([usuarioId])
  @@index([equipeId, saiuEm])
  @@map("equipe_membro")
}

model JanelaAtendimento {
  id           String   @id @db.Uuid
  equipeId     String?  @map("equipe_id") @db.Uuid
  diaSemana    Int      @map("dia_semana")
  horaInicio   Int      @map("hora_inicio")
  horaFim      Int      @map("hora_fim")
  ativo        Boolean  @default(true)
  criadoEm     DateTime @default(now()) @map("criado_em") @db.Timestamptz(6)
  atualizadoEm DateTime @updatedAt @map("atualizado_em") @db.Timestamptz(6)

  equipe Equipe? @relation(fields: [equipeId], references: [id], onDelete: Restrict)

  @@index([equipeId, diaSemana, ativo])
  @@map("janela_atendimento")
}

model Feriado {
  id              String   @id @db.Uuid
  equipeId        String?  @map("equipe_id") @db.Uuid
  data            DateTime @db.Date
  descricao       String
  recorrenteAnual Boolean  @default(false) @map("recorrente_anual")
  criadoEm        DateTime @default(now()) @map("criado_em") @db.Timestamptz(6)
  atualizadoEm    DateTime @updatedAt @map("atualizado_em") @db.Timestamptz(6)

  equipe Equipe? @relation(fields: [equipeId], references: [id], onDelete: Restrict)

  @@index([equipeId])
  @@map("feriado")
}

model Integracao {
  id             String         @id @db.Uuid
  nome           String
  tipo           IntegracaoTipo
  alvo           IntegracaoAlvo
  config         Json           @default("{}")
  segredoCifrado String?        @map("segredo_cifrado")
  segredoHash    String?        @map("segredo_hash")
  segredoUltimos4 String?       @map("segredo_ultimos4")
  ativo          Boolean        @default(true)
  ultimoUsoEm    DateTime?      @map("ultimo_uso_em") @db.Timestamptz(6)
  criadoEm       DateTime       @default(now()) @map("criado_em") @db.Timestamptz(6)
  atualizadoEm   DateTime       @updatedAt @map("atualizado_em") @db.Timestamptz(6)

  @@index([tipo])
  @@index([alvo])
  @@index([ativo])
  @@map("integracao")
}

model CrmAdminAudit {
  id            String   @id @db.Uuid
  autor         String
  quando        DateTime @db.Timestamptz(6)
  entidade      String
  entidadeId    String   @map("entidade_id") @db.Uuid
  campo         String
  valorAnterior Json?    @map("valor_anterior")
  valorNovo     Json?    @map("valor_novo")
  motivo        String
  origem        String
  criadoEm      DateTime @default(now()) @map("criado_em") @db.Timestamptz(6)

  @@index([entidade, entidadeId])
  @@map("crm_admin_audit")
}
