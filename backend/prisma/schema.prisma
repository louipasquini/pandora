// Projeto Pandora — schema base (spec 001).
// SEM model de negócio nesta spec. As entidades entram nas specs 002+.
// Convenções para models futuros (ver docs/001-bootstrap-projeto.md):
//   - PK: `id String @id @db.Uuid` gerado na aplicação via EntidadeId.novo() (UUID v7)
//   - Auditoria: `criadoEm DateTime @default(now()) @db.Timestamptz` +
//                `atualizadoEm DateTime @updatedAt @db.Timestamptz`
//   - Instantes sempre @db.Timestamptz (UTC)
//   - IDs de origem NUNCA como PK — tabelas `<entidade>_origem_ref`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================================
// RBAC (spec 004) — primeira migração de negócio do projeto.
// `perfil` e `usuario` nascem com PK UUID v7 gerada na aplicação (EntidadeId.novo()).
// Permissão NÃO é tabela: o catálogo é código (src/auth/rbac/catalogo.ts);
// `perfil_permissao.permissao` guarda o id `recurso:acao` validado contra o catálogo.
// `rbac_audit` é append-only (a aplicação nunca faz UPDATE/DELETE nela).
// ============================================================================

model Usuario {
  id               String   @id @db.Uuid
  nome             String
  email            String
  emailNormalizado String   @unique @map("email_normalizado")
  criadoEm         DateTime @default(now()) @map("criado_em") @db.Timestamptz(6)
  atualizadoEm     DateTime @updatedAt @map("atualizado_em") @db.Timestamptz(6)

  perfis                      UsuarioPerfil[]
  equipesComoMembro           EquipeMembro[]
  leadsResponsavel            Lead[]
  interacoesAutor             Interacao[]
  tagAssociacoesCriadas       TagAssociacao[]
  segmentosCriados            Segmento[]
  pipelinesUltimoAtribuido    Pipeline[]                 @relation("PipelineUltimoAtribuido")
  oportunidadesResponsavel    Oportunidade[]
  movimentacoesRealizadas     OportunidadeMovimentacao[]
  regrasAtribuicaoResponsavel RegraAtribuicaoPipeline[]
  atendimentosAtendenteAtual  Atendimento[]              @relation("AtendimentoAtendenteAtual")
  atendimentosEncerradoPor    Atendimento[]              @relation("AtendimentoEncerradoPor")
  transferenciasDe            TransferenciaAtendimento[] @relation("TransferenciaDeAtendente")
  transferenciasPara          TransferenciaAtendimento[] @relation("TransferenciaParaAtendente")
  transferenciasExecutadas    TransferenciaAtendimento[] @relation("TransferenciaExecutadaPor")
  respostasAtendimento        RespostaAtendimento[]

  @@map("usuario")
}

model Perfil {
  id              String   @id @db.Uuid
  nome            String
  nomeNormalizado String   @unique @map("nome_normalizado")
  deSistema       Boolean  @default(false) @map("de_sistema")
  criadoEm        DateTime @default(now()) @map("criado_em") @db.Timestamptz(6)
  atualizadoEm    DateTime @updatedAt @map("atualizado_em") @db.Timestamptz(6)

  permissoes PerfilPermissao[]
  usuarios   UsuarioPerfil[]

  @@map("perfil")
}

model PerfilPermissao {
  perfilId  String @map("perfil_id") @db.Uuid
  permissao String

  perfil Perfil @relation(fields: [perfilId], references: [id], onDelete: Cascade)

  @@id([perfilId, permissao])
  @@map("perfil_permissao")
}

model UsuarioPerfil {
  usuarioId String   @map("usuario_id") @db.Uuid
  perfilId  String   @map("perfil_id") @db.Uuid
  criadoEm  DateTime @default(now()) @map("criado_em") @db.Timestamptz(6)

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  perfil  Perfil  @relation(fields: [perfilId], references: [id], onDelete: Restrict)

  @@id([usuarioId, perfilId])
  @@map("usuario_perfil")
}

model RbacAudit {
  id            String   @id @db.Uuid
  autor         String
  quando        DateTime @db.Timestamptz(6)
  entidade      String
  entidadeId    String   @map("entidade_id") @db.Uuid
  campo         String
  valorAnterior Json?    @map("valor_anterior")
  valorNovo     Json?    @map("valor_novo")
  motivo        String
  origem        String
  criadoEm      DateTime @default(now()) @map("criado_em") @db.Timestamptz(6)

  @@index([entidade, entidadeId])
  @@map("rbac_audit")
}

// ============================================================================
// clientes (spec 005) — 2ª migração de negócio. `pessoa` (ex-`Cliente`), `conta`
// (household/empresa), contatos com primário+secundários, refs de origem
// (id de origem NUNCA como PK — só em `pessoa_origem_ref`), merge reversível
// (snapshot + proveniência por linha), `nota_reconciliacao` e `clientes_audit`
// (forma canônica do core, append-only, simétrico ao `rbac_audit`).
// `conta` NÃO referencia `contrato` (regra de negócio inviolável #3).
// ============================================================================

enum PlataformaOrigem {
  TMB
  ASAAS_PRD
  ASAAS_SVC
  GURU_PRD
  GURU_SVC
  HOTMART_PRD
  HOTMART_SVC
}

enum PessoaTipo {
  FISICA
  JURIDICA
  DESCONHECIDO
}

enum ContaTipo {
  HOUSEHOLD
  EMPRESA
}

enum DocumentoTipo {
  CPF
  CNPJ
}

enum MergeEstado {
  ATIVO
  DESFEITO
}

model Pessoa {
  id               String     @id @db.Uuid
  tipo             PessoaTipo @default(DESCONHECIDO)
  nome             String
  contaId          String?    @map("conta_id") @db.Uuid
  pseudonimizadaEm DateTime?  @map("pseudonimizada_em") @db.Timestamptz(6)
  mergedPara       String?    @map("merged_para") @db.Uuid
  criadoEm         DateTime   @default(now()) @map("criado_em") @db.Timestamptz(6)
  atualizadoEm     DateTime   @updatedAt @map("atualizado_em") @db.Timestamptz(6)

  conta           Conta?            @relation(fields: [contaId], references: [id], onDelete: SetNull)
  sobrevivente    Pessoa?           @relation("PessoaMerge", fields: [mergedPara], references: [id], onDelete: Restrict)
  absorvidas      Pessoa[]          @relation("PessoaMerge")
  emails          PessoaEmail[]
  telefones       PessoaTelefone[]
  documentos      PessoaDocumento[]
  enderecos       PessoaEndereco[]
  origemRefs      PessoaOrigemRef[]
  leads           Lead[]
  interacoes      Interacao[]
  tagAssociacoes  TagAssociacao[]
  oportunidades   Oportunidade[]
  optOutsWhatsapp OptOutWhatsapp[]
  atendimentos    Atendimento[]

  @@index([contaId])
  @@index([mergedPara])
  @@map("pessoa")
}

model Conta {
  id           String    @id @db.Uuid
  tipo         ContaTipo
  nome         String
  mergedPara   String?   @map("merged_para") @db.Uuid
  criadoEm     DateTime  @default(now()) @map("criado_em") @db.Timestamptz(6)
  atualizadoEm DateTime  @updatedAt @map("atualizado_em") @db.Timestamptz(6)

  sobrevivente Conta?   @relation("ContaMerge", fields: [mergedPara], references: [id], onDelete: Restrict)
  absorvidas   Conta[]  @relation("ContaMerge")
  pessoas      Pessoa[]

  @@index([mergedPara])
  @@map("conta")
}

model PessoaEmail {
  id            String    @id @db.Uuid
  pessoaId      String    @map("pessoa_id") @db.Uuid
  valor         String
  primario      Boolean   @default(false)
  curado        Boolean   @default(false)
  rebaixadoEm   DateTime? @map("rebaixado_em") @db.Timestamptz(6)
  origemMergeId String?   @map("origem_merge_id") @db.Uuid
  criadoEm      DateTime  @default(now()) @map("criado_em") @db.Timestamptz(6)
  atualizadoEm  DateTime  @updatedAt @map("atualizado_em") @db.Timestamptz(6)

  pessoa Pessoa @relation(fields: [pessoaId], references: [id], onDelete: Cascade)

  @@unique([pessoaId, valor])
  @@index([valor])
  @@map("pessoa_email")
}

model PessoaTelefone {
  id            String    @id @db.Uuid
  pessoaId      String    @map("pessoa_id") @db.Uuid
  valor         String
  primario      Boolean   @default(false)
  curado        Boolean   @default(false)
  rebaixadoEm   DateTime? @map("rebaixado_em") @db.Timestamptz(6)
  origemMergeId String?   @map("origem_merge_id") @db.Uuid
  criadoEm      DateTime  @default(now()) @map("criado_em") @db.Timestamptz(6)
  atualizadoEm  DateTime  @updatedAt @map("atualizado_em") @db.Timestamptz(6)

  pessoa Pessoa @relation(fields: [pessoaId], references: [id], onDelete: Cascade)

  @@unique([pessoaId, valor])
  @@index([valor])
  @@map("pessoa_telefone")
}

model PessoaDocumento {
  id            String        @id @db.Uuid
  pessoaId      String        @map("pessoa_id") @db.Uuid
  tipo          DocumentoTipo
  valor         String
  curado        Boolean       @default(false)
  origemMergeId String?       @map("origem_merge_id") @db.Uuid
  criadoEm      DateTime      @default(now()) @map("criado_em") @db.Timestamptz(6)
  atualizadoEm  DateTime      @updatedAt @map("atualizado_em") @db.Timestamptz(6)

  pessoa Pessoa @relation(fields: [pessoaId], references: [id], onDelete: Cascade)

  @@unique([tipo, valor])
  @@index([pessoaId])
  @@map("pessoa_documento")
}

model PessoaEndereco {
  id            String   @id @db.Uuid
  pessoaId      String   @map("pessoa_id") @db.Uuid
  logradouro    String
  numero        String?
  complemento   String?
  bairro        String?
  cidade        String?
  uf            String?
  cep           String?
  pais          String   @default("BR")
  curado        Boolean  @default(false)
  origemMergeId String?  @map("origem_merge_id") @db.Uuid
  criadoEm      DateTime @default(now()) @map("criado_em") @db.Timestamptz(6)
  atualizadoEm  DateTime @updatedAt @map("atualizado_em") @db.Timestamptz(6)

  pessoa Pessoa @relation(fields: [pessoaId], references: [id], onDelete: Cascade)

  @@index([pessoaId])
  @@map("pessoa_endereco")
}

model PessoaOrigemRef {
  id               String           @id @db.Uuid
  pessoaId         String           @map("pessoa_id") @db.Uuid
  plataformaOrigem PlataformaOrigem @map("plataforma_origem")
  tipoRef          String           @map("tipo_ref")
  valorRef         String           @map("valor_ref")
  origemMergeId    String?          @map("origem_merge_id") @db.Uuid
  criadoEm         DateTime         @default(now()) @map("criado_em") @db.Timestamptz(6)

  pessoa Pessoa @relation(fields: [pessoaId], references: [id], onDelete: Cascade)

  @@unique([plataformaOrigem, tipoRef, valorRef])
  @@index([pessoaId])
  @@index([plataformaOrigem])
  @@map("pessoa_origem_ref")
}

model MergePessoa {
  id             String      @id @db.Uuid
  sobreviventeId String      @map("sobrevivente_id") @db.Uuid
  absorvidaId    String      @map("absorvida_id") @db.Uuid
  autor          String
  quando         DateTime    @db.Timestamptz(6)
  snapshot       Json
  estado         MergeEstado @default(ATIVO)
  desfeitoPor    String?     @map("desfeito_por")
  desfeitoEm     DateTime?   @map("desfeito_em") @db.Timestamptz(6)
  criadoEm       DateTime    @default(now()) @map("criado_em") @db.Timestamptz(6)

  @@index([sobreviventeId])
  @@index([absorvidaId])
  @@map("merge_pessoa")
}

model MergeConta {
  id             String      @id @db.Uuid
  sobreviventeId String      @map("sobrevivente_id") @db.Uuid
  absorvidaId    String      @map("absorvida_id") @db.Uuid
  autor          String
  quando         DateTime    @db.Timestamptz(6)
  snapshot       Json
  estado         MergeEstado @default(ATIVO)
  desfeitoPor    String?     @map("desfeito_por")
  desfeitoEm     DateTime?   @map("desfeito_em") @db.Timestamptz(6)
  criadoEm       DateTime    @default(now()) @map("criado_em") @db.Timestamptz(6)

  @@index([sobreviventeId])
  @@index([absorvidaId])
  @@map("merge_conta")
}

model NotaReconciliacao {
  id            String   @id @db.Uuid
  entidade      String
  entidadeId    String   @map("entidade_id") @db.Uuid
  origem        String
  campo         String
  valorCurado   Json?    @map("valor_curado")
  valorDerivado Json?    @map("valor_derivado")
  motivo        String
  criadoEm      DateTime @default(now()) @map("criado_em") @db.Timestamptz(6)

  @@index([entidade, entidadeId])
  @@map("nota_reconciliacao")
}

model ClientesAudit {
  id            String   @id @db.Uuid
  autor         String
  quando        DateTime @db.Timestamptz(6)
  entidade      String
  entidadeId    String   @map("entidade_id") @db.Uuid
  campo         String
  valorAnterior Json?    @map("valor_anterior")
  valorNovo     Json?    @map("valor_novo")
  motivo        String
  origem        String
  criadoEm      DateTime @default(now()) @map("criado_em") @db.Timestamptz(6)

  @@index([entidade, entidadeId])
  @@map("clientes_audit")
}

// ============================================================================
// ingestao (spec 006) — 4ª migração de negócio. Event log imutável
// `evento_origem` (dedup por (plataforma_origem, id_origem, hash)), registro por
// etapa `evento_etapa` (pipeline canônico da visão 5.3; etapas 2–6 são no-op
// nesta spec) e `ingestao_audit` (forma canônica do core, append-only — grava só
// o reprocessamento manual). Ver docs/006-evento-origem-worker.md.
// `evento_origem` é imutável: a aplicação nunca faz UPDATE de payload_bruto/
// hash/plataforma_origem/id_origem/recebido_em.
// ============================================================================

enum EventoOrigemStatus {
  pendente
  ok
  erro
  revisar
}

enum EventoEtapaStatus {
  pendente
  processando
  ok
  erro
  bloqueada
  pulada
}

enum EtapaIngestao {
  REGISTRAR
  CLASSIFICAR
  RESOLVER_PESSOA
  UPSERT_TRANSACAO
  RESOLVER_VINCULO
  RESOLVER_OFERTA
  PROJETAR_CONTRATO
}

enum Classificacao {
  VENDA_PROPRIA
  VENDA_AFILIADA
  COBRANCA_TERCEIRIZADA
  REEMBOLSO
  RECORRENCIA
  OUTRO
  DESCONHECIDO
}

model EventoOrigem {
  id               String             @id @db.Uuid
  plataformaOrigem PlataformaOrigem   @map("plataforma_origem")
  idOrigem         String             @map("id_origem")
  tipoOrigem       String             @map("tipo_origem")
  payloadBruto     Json               @map("payload_bruto")
  eventoCanonico   Json?              @map("evento_canonico")
  hash             String
  recebidoEm       DateTime           @map("recebido_em") @db.Timestamptz(6)
  ultimoRecebidoEm DateTime           @map("ultimo_recebido_em") @db.Timestamptz(6)
  reentregas       Int                @default(0)
  status           EventoOrigemStatus @default(pendente)
  classificacao    Classificacao?
  erroDetalhe      String?            @map("erro_detalhe")
  criadoEm         DateTime           @default(now()) @map("criado_em") @db.Timestamptz(6)
  atualizadoEm     DateTime           @updatedAt @map("atualizado_em") @db.Timestamptz(6)

  etapas EventoEtapa[]

  @@unique([plataformaOrigem, idOrigem, hash], name: "evento_origem_chave_natural")
  @@index([status, recebidoEm])
  @@index([plataformaOrigem])
  @@index([classificacao])
  @@map("evento_origem")
}

model EventoEtapa {
  id             String            @id @db.Uuid
  eventoOrigemId String            @map("evento_origem_id") @db.Uuid
  etapa          EtapaIngestao
  status         EventoEtapaStatus @default(pendente)
  resultado      Json?
  erroDetalhe    String?           @map("erro_detalhe")
  tentativas     Int               @default(0)
  executadoEm    DateTime?         @map("executado_em") @db.Timestamptz(6)
  criadoEm       DateTime          @default(now()) @map("criado_em") @db.Timestamptz(6)
  atualizadoEm   DateTime          @updatedAt @map("atualizado_em") @db.Timestamptz(6)

  evento EventoOrigem @relation(fields: [eventoOrigemId], references: [id], onDelete: Restrict)

  @@unique([eventoOrigemId, etapa])
  @@index([status])
  @@map("evento_etapa")
}

model IngestaoAudit {
  id            String   @id @db.Uuid
  autor         String
  quando        DateTime @db.Timestamptz(6)
  entidade      String
  entidadeId    String   @map("entidade_id") @db.Uuid
  campo         String
  valorAnterior Json?    @map("valor_anterior")
  valorNovo     Json?    @map("valor_novo")
  motivo        String
  origem        String
  criadoEm      DateTime @default(now()) @map("criado_em") @db.Timestamptz(6)

  @@index([entidade, entidadeId])
  @@map("ingestao_audit")
}

// ============================================================================
// crm — Administração do CRM (spec 007) — 5ª migração de negócio.
// Times/squads (`equipe` + `equipe_membro`, FK -> `usuario` da 004; ≤1 vínculo
// ativo por par via índice único PARCIAL `WHERE saiu_em IS NULL`, aplicado no
// migration.sql), expediente (`janela_atendimento` + `feriado`; hora como Int
// minutos locais America/Sao_Paulo; sem cruzar meia-noite — CL-02), registro de
// integrações (`integracao`; segredo cifrado em repouso OU só-hash p/ API key
// interna; NUNCA volta em leitura — só `segredo_ultimos4` p/ a máscara) e a
// trilha `crm_admin_audit` (forma canônica do core, append-only, só delta real,
// nunca contém segredo). Ver docs/007-crm-administracao.md.
// ============================================================================

enum EquipeTipo {
  COMERCIAL
  ATENDIMENTO
  CS
}

enum PapelEquipe {
  LIDER
  MEMBRO
}

enum IntegracaoTipo {
  API_KEY
  WEBHOOK
  CONEXAO_INTERNA
}

enum IntegracaoAlvo {
  FINANCEIRO
  MARKETING
  CENTRAL
  EXTERNO
}

model Equipe {
  id                         String     @id @db.Uuid
  nome                       String
  descricao                  String?
  tipo                       EquipeTipo
  ativo                      Boolean    @default(true)
  // spec 012 — só relevantes para `tipo = ATENDIMENTO`; `null` = usa o default global.
  mensagemForaExpediente     String?    @map("mensagem_fora_expediente")
  slaPrimeiraRespostaMinutos Int?       @map("sla_primeira_resposta_minutos")
  criadoEm                   DateTime   @default(now()) @map("criado_em") @db.Timestamptz(6)
  atualizadoEm               DateTime   @updatedAt @map("atualizado_em") @db.Timestamptz(6)

  membros            EquipeMembro[]
  janelas            JanelaAtendimento[]
  feriados           Feriado[]
  pipelines          Pipeline[]
  atendimentos       Atendimento[]
  transferenciasDe   TransferenciaAtendimento[] @relation("TransferenciaDeEquipe")
  transferenciasPara TransferenciaAtendimento[] @relation("TransferenciaParaEquipe")

  @@index([ativo])
  @@map("equipe")
}

model EquipeMembro {
  id           String      @id @db.Uuid
  equipeId     String      @map("equipe_id") @db.Uuid
  usuarioId    String      @map("usuario_id") @db.Uuid
  papel        PapelEquipe
  entrouEm     DateTime    @map("entrou_em") @db.Timestamptz(6)
  saiuEm       DateTime?   @map("saiu_em") @db.Timestamptz(6)
  criadoEm     DateTime    @default(now()) @map("criado_em") @db.Timestamptz(6)
  atualizadoEm DateTime    @updatedAt @map("atualizado_em") @db.Timestamptz(6)

  equipe  Equipe  @relation(fields: [equipeId], references: [id], onDelete: Restrict)
  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Restrict)

  // O índice único PARCIAL `(equipe_id, usuario_id) WHERE saiu_em IS NULL`
  // (≤1 vínculo ativo por par; histórico de reentrada permitido) é criado no
  // migration.sql — o Prisma não expressa índice parcial no schema.
  @@index([usuarioId])
  @@index([equipeId, saiuEm])
  @@map("equipe_membro")
}

model JanelaAtendimento {
  id           String   @id @db.Uuid
  equipeId     String?  @map("equipe_id") @db.Uuid
  diaSemana    Int      @map("dia_semana")
  horaInicio   Int      @map("hora_inicio")
  horaFim      Int      @map("hora_fim")
  ativo        Boolean  @default(true)
  criadoEm     DateTime @default(now()) @map("criado_em") @db.Timestamptz(6)
  atualizadoEm DateTime @updatedAt @map("atualizado_em") @db.Timestamptz(6)

  equipe Equipe? @relation(fields: [equipeId], references: [id], onDelete: Restrict)

  @@index([equipeId, diaSemana, ativo])
  @@map("janela_atendimento")
}

model Feriado {
  id              String   @id @db.Uuid
  equipeId        String?  @map("equipe_id") @db.Uuid
  data            DateTime @db.Date
  descricao       String
  recorrenteAnual Boolean  @default(false) @map("recorrente_anual")
  criadoEm        DateTime @default(now()) @map("criado_em") @db.Timestamptz(6)
  atualizadoEm    DateTime @updatedAt @map("atualizado_em") @db.Timestamptz(6)

  equipe Equipe? @relation(fields: [equipeId], references: [id], onDelete: Restrict)

  @@index([equipeId])
  @@map("feriado")
}

model Integracao {
  id              String         @id @db.Uuid
  nome            String
  tipo            IntegracaoTipo
  alvo            IntegracaoAlvo
  config          Json           @default("{}")
  segredoCifrado  String?        @map("segredo_cifrado")
  segredoHash     String?        @map("segredo_hash")
  segredoUltimos4 String?        @map("segredo_ultimos4")
  ativo           Boolean        @default(true)
  ultimoUsoEm     DateTime?      @map("ultimo_uso_em") @db.Timestamptz(6)
  criadoEm        DateTime       @default(now()) @map("criado_em") @db.Timestamptz(6)
  atualizadoEm    DateTime       @updatedAt @map("atualizado_em") @db.Timestamptz(6)

  @@index([tipo])
  @@index([alvo])
  @@index([ativo])
  @@map("integracao")
}

model CrmAdminAudit {
  id            String   @id @db.Uuid
  autor         String
  quando        DateTime @db.Timestamptz(6)
  entidade      String
  entidadeId    String   @map("entidade_id") @db.Uuid
  campo         String
  valorAnterior Json?    @map("valor_anterior")
  valorNovo     Json?    @map("valor_novo")
  motivo        String
  origem        String
  criadoEm      DateTime @default(now()) @map("criado_em") @db.Timestamptz(6)

  @@index([entidade, entidadeId])
  @@map("crm_admin_audit")
}

// ============================================================================
// crm — Lead (spec 008) — 6ª migração de negócio.
// `lead` é a 1ª entidade COMPARTILHADA do projeto (CRM + Marketing numa única
// tabela; acesso resolvido por RBAC 004, não por fronteira — visão Parte 8.2.1).
// `score` é DERIVADO por `calcularScore` (função pura; regra 8.2.2) — nunca
// contador incremental, nunca setável por PATCH. Conversão -> `pessoa` reusa a
// engine da 005 via a interface `PortaIdentidade` do `core` (inversão de
// dependência — CL-02); pós-conversão o `lead` é arquivado+vinculado (CL-01).
// Campos personalizados: esquema administrável (CL-03) — `campo_personalizado_lead`
// (definição, sob `crm_admin:gerir_campos_lead`) + `valor_campo_lead` (valores
// validados por tipo). `crm_lead_audit` = forma canônica do core, append-only,
// só delta real. O índice único PARCIAL `(origem, id_externo) WHERE id_externo IS
// NOT NULL` (idempotência da porta `RegistrarLeadService`) é criado no
// migration.sql. Ver docs/008-crm-lead.md.
// ============================================================================

enum LeadEstagio {
  NOVO
  CONTATO_FEITO
  QUALIFICADO
  NUTRICAO
  DESQUALIFICADO
}

enum LeadStatus {
  ATIVO
  DESCARTADO
  CONVERTIDO
}

enum CampoPersonalizadoTipo {
  TEXTO
  NUMERO
  BOOLEANO
  DATA
  SELECAO
}

model Lead {
  id                String      @id @db.Uuid
  nome              String
  email             String?
  telefone          String?
  documento         String?
  origem            String?
  idExterno         String?     @map("id_externo")
  utmSource         String?     @map("utm_source")
  utmMedium         String?     @map("utm_medium")
  utmCampaign       String?     @map("utm_campaign")
  utmTerm           String?     @map("utm_term")
  utmContent        String?     @map("utm_content")
  estagio           LeadEstagio @default(NOVO)
  status            LeadStatus  @default(ATIVO)
  responsavelId     String?     @map("responsavel_id") @db.Uuid
  score             Int         @default(0)
  scoreAtualizadoEm DateTime?   @map("score_atualizado_em") @db.Timestamptz(6)
  pessoaId          String?     @map("pessoa_id") @db.Uuid
  convertidoEm      DateTime?   @map("convertido_em") @db.Timestamptz(6)
  criadoEm          DateTime    @default(now()) @map("criado_em") @db.Timestamptz(6)
  atualizadoEm      DateTime    @updatedAt @map("atualizado_em") @db.Timestamptz(6)

  responsavel     Usuario?         @relation(fields: [responsavelId], references: [id], onDelete: Restrict)
  pessoa          Pessoa?          @relation(fields: [pessoaId], references: [id], onDelete: Restrict)
  valores         ValorCampoLead[]
  interacoes      Interacao[]
  tagAssociacoes  TagAssociacao[]
  oportunidades   Oportunidade[]
  optOutsWhatsapp OptOutWhatsapp[]
  atendimentos    Atendimento[]

  // Índice único PARCIAL `(origem, id_externo) WHERE id_externo IS NOT NULL`
  // criado no migration.sql — o Prisma não expressa índice parcial no schema.
  @@index([status, estagio])
  @@index([responsavelId])
  @@index([origem])
  @@index([email])
  @@index([telefone])
  @@index([pessoaId])
  @@map("lead")
}

model CampoPersonalizadoLead {
  id           String                 @id @db.Uuid
  chave        String                 @unique
  rotulo       String
  tipo         CampoPersonalizadoTipo
  opcoes       String[]               @default([])
  obrigatorio  Boolean                @default(false)
  ativo        Boolean                @default(true)
  criadoEm     DateTime               @default(now()) @map("criado_em") @db.Timestamptz(6)
  atualizadoEm DateTime               @updatedAt @map("atualizado_em") @db.Timestamptz(6)

  valores ValorCampoLead[]

  @@map("campo_personalizado_lead")
}

model ValorCampoLead {
  id           String   @id @db.Uuid
  leadId       String   @map("lead_id") @db.Uuid
  definicaoId  String   @map("definicao_id") @db.Uuid
  valor        String
  criadoEm     DateTime @default(now()) @map("criado_em") @db.Timestamptz(6)
  atualizadoEm DateTime @updatedAt @map("atualizado_em") @db.Timestamptz(6)

  lead      Lead                   @relation(fields: [leadId], references: [id], onDelete: Cascade)
  definicao CampoPersonalizadoLead @relation(fields: [definicaoId], references: [id], onDelete: Restrict)

  @@unique([leadId, definicaoId])
  @@index([definicaoId])
  @@map("valor_campo_lead")
}

model CrmLeadAudit {
  id            String   @id @db.Uuid
  autor         String
  quando        DateTime @db.Timestamptz(6)
  entidade      String
  entidadeId    String   @map("entidade_id") @db.Uuid
  campo         String
  valorAnterior Json?    @map("valor_anterior")
  valorNovo     Json?    @map("valor_novo")
  motivo        String
  origem        String
  criadoEm      DateTime @default(now()) @map("criado_em") @db.Timestamptz(6)

  @@index([entidade, entidadeId])
  @@map("crm_lead_audit")
}

// ============================================================================
// crm — interação/tag/segmento (spec 009) — 7ª migração de negócio. Fecha o
// esboço 5.2-E: `interacao` (timeline unificada pessoa/lead, âncora XOR — CHECK
// no migration.sql, CL-01), `tag`/`tag_associacao` (entidade de 1ª classe
// compartilhada lead|pessoa|interacao, promovendo o `lead.tags: String[]` da
// 008 — a coluna é removida acima), `segmento` (query salva declarativa,
// membros sempre derivados na leitura — nunca materializados, regra 8.2.2).
// `crm_interacao_audit` = forma canônica do core, append-only, só delta real.
// FKs para `pessoa`/`usuario` são só schema.prisma compartilhado (mesmo
// precedente de `Lead.pessoaId`/`Lead.responsavelId`) — nenhuma porta nova no
// `core`. Ver docs/009-crm-interacao-timeline.md.
// ============================================================================

enum InteracaoTipo {
  WHATSAPP
  EMAIL
  LIGACAO
  TICKET
  NOTA
  NPS
}

enum InteracaoDirecao {
  ENTRADA
  SAIDA
}

enum SegmentoAlvo {
  LEAD
  PESSOA
}

model Interacao {
  id            String            @id @db.Uuid
  pessoaId      String?           @map("pessoa_id") @db.Uuid
  leadId        String?           @map("lead_id") @db.Uuid
  tipo          InteracaoTipo
  direcao       InteracaoDirecao?
  conteudo      String
  notaNps       Int?              @map("nota_nps")
  autorId       String?           @map("autor_id") @db.Uuid
  canalOrigem   String?           @map("canal_origem")
  idExterno     String?           @map("id_externo")
  // spec 012 — agrupa a interação sob um atendimento (fila/CSAT/etc.), sem
  // alterar nenhum contrato já validado pela 009 (SetNull: interacao nunca
  // perde dado por causa de atendimento).
  atendimentoId String?           @map("atendimento_id") @db.Uuid
  ocorridoEm    DateTime          @map("ocorrido_em") @db.Timestamptz(6)
  editadoEm     DateTime?         @map("editado_em") @db.Timestamptz(6)
  removidoEm    DateTime?         @map("removido_em") @db.Timestamptz(6)
  criadoEm      DateTime          @default(now()) @map("criado_em") @db.Timestamptz(6)
  atualizadoEm  DateTime          @updatedAt @map("atualizado_em") @db.Timestamptz(6)

  pessoa              Pessoa?              @relation(fields: [pessoaId], references: [id], onDelete: Restrict)
  lead                Lead?                @relation(fields: [leadId], references: [id], onDelete: Restrict)
  autor               Usuario?             @relation(fields: [autorId], references: [id], onDelete: Restrict)
  atendimento         Atendimento?         @relation(fields: [atendimentoId], references: [id], onDelete: SetNull)
  tagAssociacoes      TagAssociacao[]
  mensagemWhatsapp    MensagemWhatsapp?
  respostaAtendimento RespostaAtendimento?

  // CHECK (num_nonnulls(pessoa_id, lead_id) = 1) — âncora exclusiva (CL-01),
  // criado no migration.sql (Prisma não modela CHECK). Índice único PARCIAL
  // (canal_origem, id_externo) WHERE ambos NOT NULL — idempotência da porta —
  // também no migration.sql.
  @@index([pessoaId, ocorridoEm])
  @@index([leadId, ocorridoEm])
  @@index([tipo])
  @@index([atendimentoId, ocorridoEm])
  @@map("interacao")
}

model Tag {
  id           String   @id @db.Uuid
  slug         String   @unique
  rotulo       String
  cor          String?
  ativo        Boolean  @default(true)
  criadoEm     DateTime @default(now()) @map("criado_em") @db.Timestamptz(6)
  atualizadoEm DateTime @updatedAt @map("atualizado_em") @db.Timestamptz(6)

  associacoes TagAssociacao[]

  @@map("tag")
}

model TagAssociacao {
  id          String   @id @db.Uuid
  tagId       String   @map("tag_id") @db.Uuid
  leadId      String?  @map("lead_id") @db.Uuid
  pessoaId    String?  @map("pessoa_id") @db.Uuid
  interacaoId String?  @map("interacao_id") @db.Uuid
  criadoPor   String?  @map("criado_por") @db.Uuid
  criadoEm    DateTime @default(now()) @map("criado_em") @db.Timestamptz(6)

  tag       Tag        @relation(fields: [tagId], references: [id], onDelete: Restrict)
  lead      Lead?      @relation(fields: [leadId], references: [id], onDelete: Cascade)
  pessoa    Pessoa?    @relation(fields: [pessoaId], references: [id], onDelete: Cascade)
  interacao Interacao? @relation(fields: [interacaoId], references: [id], onDelete: Cascade)
  autor     Usuario?   @relation(fields: [criadoPor], references: [id], onDelete: Restrict)

  // CHECK (num_nonnulls(lead_id, pessoa_id, interacao_id) = 1) + 3 índices
  // únicos PARCIAIS (tag_id, <ancora>) WHERE <ancora> IS NOT NULL — nenhuma
  // tag duplicada na mesma âncora (FR-016). Ambos no migration.sql.
  @@index([tagId])
  @@map("tag_associacao")
}

model Segmento {
  id           String       @id @db.Uuid
  nome         String
  descricao    String?
  alvo         SegmentoAlvo
  filtro       Json
  ativo        Boolean      @default(true)
  // Nullable: `criadoPor` só é gravado quando o sujeito é um `Usuario` real —
  // a credencial de serviço (que também cria segmentos, ex. via testes/automação
  // administrativa) não tem linha em `usuario` (mesmo tratamento de
  // `interacao.autorId`/`tag_associacao.criadoPor`).
  criadoPor    String?      @map("criado_por") @db.Uuid
  criadoEm     DateTime     @default(now()) @map("criado_em") @db.Timestamptz(6)
  atualizadoEm DateTime     @updatedAt @map("atualizado_em") @db.Timestamptz(6)

  autor Usuario? @relation(fields: [criadoPor], references: [id], onDelete: Restrict)

  @@index([alvo])
  @@map("segmento")
}

model CrmInteracaoAudit {
  id            String   @id @db.Uuid
  autor         String
  quando        DateTime @db.Timestamptz(6)
  entidade      String
  entidadeId    String   @map("entidade_id") @db.Uuid
  campo         String
  valorAnterior Json?    @map("valor_anterior")
  valorNovo     Json?    @map("valor_novo")
  motivo        String
  origem        String
  criadoEm      DateTime @default(now()) @map("criado_em") @db.Timestamptz(6)

  @@index([entidade, entidadeId])
  @@map("crm_interacao_audit")
}

// ============================================================================
// Pipeline / Oportunidade do CRM (spec 010) — visão Parte 8.7. `oportunidade`
// segue a mesma âncora polimórfica `pessoa` XOR `lead` da `interacao` (009).
// `oportunidade_movimentacao` é o histórico de 1ª classe de mudança de etapa
// (fonte de SLA/métricas — nunca contador incremental, Princípio V).
// `PortaObservacaoPagamentoCrm` (sem tabela própria) é implementada em
// application/pipeline/porta-observacao-pagamento.service.ts.
// ============================================================================

enum EtapaPipelineTipo {
  ABERTA
  GANHA
  PERDIDA
}

enum ModoAtribuicao {
  MANUAL
  RODIZIO
  REGRA
}

enum RegraAtribuicaoCampo {
  ORIGEM
  VALOR_ESTIMADO_MINIMO
}

model Pipeline {
  id                       String          @id @db.Uuid
  nome                     String
  descricao                String?
  equipeId                 String?         @map("equipe_id") @db.Uuid
  modoAtribuicao           ModoAtribuicao  @default(MANUAL) @map("modo_atribuicao")
  atribuicaoFallback       ModoAtribuicao? @map("atribuicao_fallback")
  diasEsfriando            Int?            @map("dias_esfriando")
  ultimoAtribuidoUsuarioId String?         @map("ultimo_atribuido_usuario_id") @db.Uuid
  ativo                    Boolean         @default(true)
  criadoEm                 DateTime        @default(now()) @map("criado_em") @db.Timestamptz(6)
  atualizadoEm             DateTime        @updatedAt @map("atualizado_em") @db.Timestamptz(6)

  equipe           Equipe?                   @relation(fields: [equipeId], references: [id], onDelete: Restrict)
  ultimoAtribuido  Usuario?                  @relation("PipelineUltimoAtribuido", fields: [ultimoAtribuidoUsuarioId], references: [id], onDelete: SetNull)
  etapas           EtapaPipeline[]
  oportunidades    Oportunidade[]
  regrasAtribuicao RegraAtribuicaoPipeline[]

  @@index([ativo])
  @@map("pipeline")
}

model EtapaPipeline {
  id           String            @id @db.Uuid
  pipelineId   String            @map("pipeline_id") @db.Uuid
  nome         String
  ordem        Int
  tipo         EtapaPipelineTipo
  slaHoras     Int?              @map("sla_horas")
  criadoEm     DateTime          @default(now()) @map("criado_em") @db.Timestamptz(6)
  atualizadoEm DateTime          @updatedAt @map("atualizado_em") @db.Timestamptz(6)

  pipeline              Pipeline                   @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  oportunidades         Oportunidade[]
  movimentacoesAnterior OportunidadeMovimentacao[] @relation("MovimentacaoEtapaAnterior")
  movimentacoesNova     OportunidadeMovimentacao[] @relation("MovimentacaoEtapaNova")

  // Índice único (pipeline_id, ordem) já coberto por @@unique abaixo.
  @@unique([pipelineId, ordem])
  @@index([pipelineId, tipo])
  @@map("etapa_pipeline")
}

model Oportunidade {
  id                     String    @id @db.Uuid
  pipelineId             String    @map("pipeline_id") @db.Uuid
  etapaId                String    @map("etapa_id") @db.Uuid
  pessoaId               String?   @map("pessoa_id") @db.Uuid
  leadId                 String?   @map("lead_id") @db.Uuid
  titulo                 String
  valorEstimadoInt       BigInt    @map("valor_estimado_int")
  valorEstimadoMoeda     String    @map("valor_estimado_moeda") @db.Char(3)
  responsavelId          String?   @map("responsavel_id") @db.Uuid
  dataPrevistaFechamento DateTime? @map("data_prevista_fechamento") @db.Date
  entrouEtapaEm          DateTime  @map("entrou_etapa_em") @db.Timestamptz(6)
  criadoEm               DateTime  @default(now()) @map("criado_em") @db.Timestamptz(6)
  atualizadoEm           DateTime  @updatedAt @map("atualizado_em") @db.Timestamptz(6)

  pipeline      Pipeline                   @relation(fields: [pipelineId], references: [id], onDelete: Restrict)
  etapa         EtapaPipeline              @relation(fields: [etapaId], references: [id], onDelete: Restrict)
  pessoa        Pessoa?                    @relation(fields: [pessoaId], references: [id], onDelete: Restrict)
  lead          Lead?                      @relation(fields: [leadId], references: [id], onDelete: Restrict)
  responsavel   Usuario?                   @relation(fields: [responsavelId], references: [id], onDelete: Restrict)
  movimentacoes OportunidadeMovimentacao[]
  valoresCampos ValorCampoOportunidade[]

  // CHECK (num_nonnulls(pessoa_id, lead_id) = 1) — âncora exclusiva (D-01),
  // criado no migration.sql (Prisma não modela CHECK).
  @@index([pipelineId, etapaId])
  @@index([responsavelId])
  @@index([pessoaId])
  @@index([leadId])
  @@map("oportunidade")
}

model OportunidadeMovimentacao {
  id              String   @id @db.Uuid
  oportunidadeId  String   @map("oportunidade_id") @db.Uuid
  etapaAnteriorId String?  @map("etapa_anterior_id") @db.Uuid
  etapaNovaId     String   @map("etapa_nova_id") @db.Uuid
  movidoPorId     String?  @map("movido_por_id") @db.Uuid
  motivo          String?
  criadoEm        DateTime @default(now()) @map("criado_em") @db.Timestamptz(6)

  oportunidade  Oportunidade   @relation(fields: [oportunidadeId], references: [id], onDelete: Cascade)
  etapaAnterior EtapaPipeline? @relation("MovimentacaoEtapaAnterior", fields: [etapaAnteriorId], references: [id], onDelete: Restrict)
  etapaNova     EtapaPipeline  @relation("MovimentacaoEtapaNova", fields: [etapaNovaId], references: [id], onDelete: Restrict)
  movidoPor     Usuario?       @relation(fields: [movidoPorId], references: [id], onDelete: Restrict)

  // Append-only — sem PATCH/DELETE (histórico de 1ª classe, FR-012).
  @@index([oportunidadeId, criadoEm])
  @@map("oportunidade_movimentacao")
}

model RegraAtribuicaoPipeline {
  id            String               @id @db.Uuid
  pipelineId    String               @map("pipeline_id") @db.Uuid
  ordem         Int
  campo         RegraAtribuicaoCampo
  valor         Json
  responsavelId String               @map("responsavel_id") @db.Uuid
  criadoEm      DateTime             @default(now()) @map("criado_em") @db.Timestamptz(6)
  atualizadoEm  DateTime             @updatedAt @map("atualizado_em") @db.Timestamptz(6)

  pipeline    Pipeline @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  responsavel Usuario  @relation(fields: [responsavelId], references: [id], onDelete: Restrict)

  @@unique([pipelineId, ordem])
  @@map("regra_atribuicao_pipeline")
}

model CampoPersonalizadoOportunidade {
  id           String                 @id @db.Uuid
  chave        String                 @unique
  rotulo       String
  tipo         CampoPersonalizadoTipo
  opcoes       String[]               @default([])
  obrigatorio  Boolean                @default(false)
  ativo        Boolean                @default(true)
  criadoEm     DateTime               @default(now()) @map("criado_em") @db.Timestamptz(6)
  atualizadoEm DateTime               @updatedAt @map("atualizado_em") @db.Timestamptz(6)

  valores ValorCampoOportunidade[]

  @@map("campo_personalizado_oportunidade")
}

model ValorCampoOportunidade {
  id             String   @id @db.Uuid
  oportunidadeId String   @map("oportunidade_id") @db.Uuid
  definicaoId    String   @map("definicao_id") @db.Uuid
  valor          String
  criadoEm       DateTime @default(now()) @map("criado_em") @db.Timestamptz(6)
  atualizadoEm   DateTime @updatedAt @map("atualizado_em") @db.Timestamptz(6)

  oportunidade Oportunidade                   @relation(fields: [oportunidadeId], references: [id], onDelete: Cascade)
  definicao    CampoPersonalizadoOportunidade @relation(fields: [definicaoId], references: [id], onDelete: Restrict)

  @@unique([oportunidadeId, definicaoId])
  @@index([definicaoId])
  @@map("valor_campo_oportunidade")
}

model CrmPipelineAudit {
  id            String   @id @db.Uuid
  autor         String
  quando        DateTime @db.Timestamptz(6)
  entidade      String
  entidadeId    String   @map("entidade_id") @db.Uuid
  campo         String
  valorAnterior Json?    @map("valor_anterior")
  valorNovo     Json?    @map("valor_novo")
  motivo        String
  origem        String
  criadoEm      DateTime @default(now()) @map("criado_em") @db.Timestamptz(6)

  @@index([entidade, entidadeId])
  @@map("crm_pipeline_audit")
}

// ============================================================================
// crm — Integração com WhatsApp (spec 011) — 9ª migração de negócio. Conecta o
// WhatsApp Business (Cloud API oficial da Meta) como canal de 1ª classe do CRM.
// `canal_whatsapp` (conexão — segredos cifrados com a MESMA `CRM_INTEGRACAO_
// CIFRA_KEY` da 007, reaproveitando `cifrar`/`mascararSegredo`), `template_
// whatsapp` (catálogo espelhado da Meta, sincronizado só sob demanda —
// Princípio VIII), `mensagem_whatsapp` (detalhe 1:1 de uma `interacao` tipo
// WHATSAPP já existente desde a 009 — mantém `interacao` agnóstica de canal),
// `evento_webhook_whatsapp` (evento cru imutável do webhook, dedupado por hash
// — NÃO reaproveita `evento_origem`/`PlataformaOrigem` da `ingestao`, que é
// uma dimensão fechada das 7 contas financeiras — ver research.md da 011) e
// `opt_out_whatsapp` (histórico de pedidos de não-contato, LGPD — nunca um
// UPDATE que apague o pedido original). Nenhuma tabela de auditoria nova:
// canal/template/opt-out auditam em `crm_admin_audit` (007, já
// entidade-agnóstica). Ver docs/011-crm-whatsapp-integracao.md.
// ============================================================================

enum TemplateWhatsappCategoria {
  MARKETING
  UTILITY
  AUTHENTICATION
}

enum TemplateWhatsappStatus {
  PENDENTE
  APROVADO
  REJEITADO
  PAUSADO
  DESABILITADO
}

enum MensagemWhatsappTipoConteudo {
  TEXTO
  IMAGEM
  AUDIO
  DOCUMENTO
  VIDEO
  OUTRO
}

enum MensagemWhatsappStatusEntrega {
  RECEBIDA
  ENVIADA
  ENTREGUE
  LIDA
  FALHOU
}

enum EventoWebhookWhatsappStatus {
  PENDENTE
  PROCESSADO
  ERRO
}

enum OptOutWhatsappOrigem {
  PROPRIO_NUMERO
  ATENDENTE
}

model CanalWhatsapp {
  id                         String    @id @db.Uuid
  nome                       String
  numeroTelefone             String    @map("numero_telefone")
  wabaId                     String    @map("waba_id")
  phoneNumberId              String    @map("phone_number_id")
  accessTokenCifrado         String    @map("access_token_cifrado")
  accessTokenUltimos4        String    @map("access_token_ultimos4")
  appSecretCifrado           String    @map("app_secret_cifrado")
  appSecretUltimos4          String    @map("app_secret_ultimos4")
  webhookVerifyTokenCifrado  String    @map("webhook_verify_token_cifrado")
  webhookVerifyTokenUltimos4 String    @map("webhook_verify_token_ultimos4")
  ativo                      Boolean   @default(true)
  ultimoWebhookRecebidoEm    DateTime? @map("ultimo_webhook_recebido_em") @db.Timestamptz(6)
  criadoEm                   DateTime  @default(now()) @map("criado_em") @db.Timestamptz(6)
  atualizadoEm               DateTime  @updatedAt @map("atualizado_em") @db.Timestamptz(6)

  templates      TemplateWhatsapp[]
  mensagens      MensagemWhatsapp[]
  eventosWebhook EventoWebhookWhatsapp[]
  atendimentos   Atendimento[]

  @@unique([phoneNumberId])
  @@index([ativo])
  @@map("canal_whatsapp")
}

model TemplateWhatsapp {
  id              String                    @id @db.Uuid
  canalId         String                    @map("canal_id") @db.Uuid
  nomeMeta        String                    @map("nome_meta")
  idioma          String
  categoria       TemplateWhatsappCategoria
  corpo           String
  statusAprovacao TemplateWhatsappStatus    @map("status_aprovacao")
  motivoRejeicao  String?                   @map("motivo_rejeicao")
  sincronizadoEm  DateTime                  @map("sincronizado_em") @db.Timestamptz(6)
  criadoEm        DateTime                  @default(now()) @map("criado_em") @db.Timestamptz(6)
  atualizadoEm    DateTime                  @updatedAt @map("atualizado_em") @db.Timestamptz(6)

  canal     CanalWhatsapp      @relation(fields: [canalId], references: [id], onDelete: Restrict)
  mensagens MensagemWhatsapp[]

  @@unique([canalId, nomeMeta, idioma])
  @@index([canalId, statusAprovacao])
  @@map("template_whatsapp")
}

model MensagemWhatsapp {
  id             String                        @id @db.Uuid
  interacaoId    String                        @unique @map("interacao_id") @db.Uuid
  canalId        String                        @map("canal_id") @db.Uuid
  templateId     String?                       @map("template_id") @db.Uuid
  waMessageId    String?                       @map("wa_message_id")
  tipoConteudo   MensagemWhatsappTipoConteudo  @default(TEXTO) @map("tipo_conteudo")
  midiaIdExterno String?                       @map("midia_id_externo")
  statusEntrega  MensagemWhatsappStatusEntrega @map("status_entrega")
  erroDetalhe    String?                       @map("erro_detalhe")
  criadoEm       DateTime                      @default(now()) @map("criado_em") @db.Timestamptz(6)
  atualizadoEm   DateTime                      @updatedAt @map("atualizado_em") @db.Timestamptz(6)

  interacao Interacao         @relation(fields: [interacaoId], references: [id], onDelete: Cascade)
  canal     CanalWhatsapp     @relation(fields: [canalId], references: [id], onDelete: Restrict)
  template  TemplateWhatsapp? @relation(fields: [templateId], references: [id], onDelete: Restrict)

  // Índice único PARCIAL `(wa_message_id) WHERE wa_message_id IS NOT NULL`
  // criado no migration.sql — o Prisma não expressa índice parcial no schema.
  @@index([canalId])
  @@index([templateId])
  @@map("mensagem_whatsapp")
}

model EventoWebhookWhatsapp {
  id           String                      @id @db.Uuid
  canalId      String?                     @map("canal_id") @db.Uuid
  payloadBruto Json                        @map("payload_bruto")
  hash         String
  recebidoEm   DateTime                    @map("recebido_em") @db.Timestamptz(6)
  status       EventoWebhookWhatsappStatus @default(PENDENTE)
  erroDetalhe  String?                     @map("erro_detalhe")
  criadoEm     DateTime                    @default(now()) @map("criado_em") @db.Timestamptz(6)

  canal CanalWhatsapp? @relation(fields: [canalId], references: [id], onDelete: Restrict)

  @@unique([hash])
  @@index([status, recebidoEm])
  @@map("evento_webhook_whatsapp")
}

model OptOutWhatsapp {
  id           String               @id @db.Uuid
  telefone     String
  pessoaId     String?              @map("pessoa_id") @db.Uuid
  leadId       String?              @map("lead_id") @db.Uuid
  origem       OptOutWhatsappOrigem
  optadoEm     DateTime             @map("optado_em") @db.Timestamptz(6)
  revertidoEm  DateTime?            @map("revertido_em") @db.Timestamptz(6)
  criadoEm     DateTime             @default(now()) @map("criado_em") @db.Timestamptz(6)
  atualizadoEm DateTime             @updatedAt @map("atualizado_em") @db.Timestamptz(6)

  pessoa Pessoa? @relation(fields: [pessoaId], references: [id], onDelete: Restrict)
  lead   Lead?   @relation(fields: [leadId], references: [id], onDelete: Restrict)

  @@index([telefone, optadoEm])
  @@map("opt_out_whatsapp")
}

// ============================================================================
// crm — Chat ao Vivo (spec 012) — 10ª migração de negócio. Inbox de atendimento
// que constrói SOBRE a timeline de `interacao` já existente (009) — não é uma
// 2ª tabela de mensagens (a coluna `interacao.atendimento_id` acima agrupa o
// que já existe). `atendimento` (a conversa/caso — fila, prioridade, atendente/
// equipe atual, SLA de 1ª resposta sempre DERIVADO, elegibilidade de CSAT),
// `transferencia_atendimento` (histórico append-only de 1ª classe — não é o
// audit genérico, mesmo raciocínio de `oportunidade_movimentacao`, spec 010),
// `resposta_atendimento` (detalhe 1:1 de uma `interacao` de saída — quem
// respondeu, com/sem IA). Endereçamento (`escolherAtendentePorCarga`) e SLA
// (`calcularSlaAtendimento`) são funções PURAS em `crm/domain/atendimento/` —
// nunca contador/coluna persistidos, nunca job de fundo (volume baixo, CL-02
// do spec.md). CSAT reaproveita `interacao` tipo `NPS` — nenhuma tabela nova.
// Ver docs/012-crm-chat-ao-vivo.md e specs/012-crm-chat-ao-vivo/research.md.
// ============================================================================

enum AtendimentoCanal {
  WHATSAPP
  MANUAL
}

enum AtendimentoStatus {
  AGUARDANDO
  EM_ATENDIMENTO
  ENCERRADO
}

enum AtendimentoPrioridade {
  NORMAL
  ALTA
  URGENTE
}

model Atendimento {
  id                 String                @id @db.Uuid
  pessoaId           String?               @map("pessoa_id") @db.Uuid
  leadId             String?               @map("lead_id") @db.Uuid
  canal              AtendimentoCanal
  canalWhatsappId    String?               @map("canal_whatsapp_id") @db.Uuid
  equipeId           String?               @map("equipe_id") @db.Uuid
  atendenteAtualId   String?               @map("atendente_atual_id") @db.Uuid
  status             AtendimentoStatus     @default(AGUARDANDO)
  prioridade         AtendimentoPrioridade @default(NORMAL)
  abertoEm           DateTime              @map("aberto_em") @db.Timestamptz(6)
  primeiraRespostaEm DateTime?             @map("primeira_resposta_em") @db.Timestamptz(6)
  slaMinutos         Int                   @map("sla_minutos")
  encerradoEm        DateTime?             @map("encerrado_em") @db.Timestamptz(6)
  encerradoPorId     String?               @map("encerrado_por_id") @db.Uuid
  motivoEncerramento String?               @map("motivo_encerramento")
  csatSolicitadoEm   DateTime?             @map("csat_solicitado_em") @db.Timestamptz(6)
  criadoEm           DateTime              @default(now()) @map("criado_em") @db.Timestamptz(6)
  atualizadoEm       DateTime              @updatedAt @map("atualizado_em") @db.Timestamptz(6)

  pessoa         Pessoa?                    @relation(fields: [pessoaId], references: [id], onDelete: Restrict)
  lead           Lead?                      @relation(fields: [leadId], references: [id], onDelete: Restrict)
  canalWhatsapp  CanalWhatsapp?             @relation(fields: [canalWhatsappId], references: [id], onDelete: Restrict)
  equipe         Equipe?                    @relation(fields: [equipeId], references: [id], onDelete: Restrict)
  atendenteAtual Usuario?                   @relation("AtendimentoAtendenteAtual", fields: [atendenteAtualId], references: [id], onDelete: Restrict)
  encerradoPor   Usuario?                   @relation("AtendimentoEncerradoPor", fields: [encerradoPorId], references: [id], onDelete: Restrict)
  interacoes     Interacao[]
  transferencias TransferenciaAtendimento[]
  respostas      RespostaAtendimento[]

  // CHECK (num_nonnulls(pessoa_id, lead_id) = 1) — âncora exclusiva (mesma
  // disciplina de Interacao/Oportunidade), criado no migration.sql.
  @@index([status, prioridade, abertoEm])
  @@index([atendenteAtualId, status])
  @@index([equipeId, status])
  @@index([pessoaId])
  @@index([leadId])
  @@map("atendimento")
}

model TransferenciaAtendimento {
  id               String   @id @db.Uuid
  atendimentoId    String   @map("atendimento_id") @db.Uuid
  deAtendenteId    String?  @map("de_atendente_id") @db.Uuid
  paraAtendenteId  String?  @map("para_atendente_id") @db.Uuid
  deEquipeId       String?  @map("de_equipe_id") @db.Uuid
  paraEquipeId     String?  @map("para_equipe_id") @db.Uuid
  transferidoPorId String?  @map("transferido_por_id") @db.Uuid
  motivo           String?
  criadoEm         DateTime @default(now()) @map("criado_em") @db.Timestamptz(6)

  atendimento    Atendimento @relation(fields: [atendimentoId], references: [id], onDelete: Cascade)
  deAtendente    Usuario?    @relation("TransferenciaDeAtendente", fields: [deAtendenteId], references: [id], onDelete: Restrict)
  paraAtendente  Usuario?    @relation("TransferenciaParaAtendente", fields: [paraAtendenteId], references: [id], onDelete: Restrict)
  deEquipe       Equipe?     @relation("TransferenciaDeEquipe", fields: [deEquipeId], references: [id], onDelete: Restrict)
  paraEquipe     Equipe?     @relation("TransferenciaParaEquipe", fields: [paraEquipeId], references: [id], onDelete: Restrict)
  transferidoPor Usuario?    @relation("TransferenciaExecutadaPor", fields: [transferidoPorId], references: [id], onDelete: Restrict)

  // Append-only — sem PATCH/DELETE (histórico de 1ª classe, FR-008).
  @@index([atendimentoId, criadoEm])
  @@map("transferencia_atendimento")
}

model RespostaAtendimento {
  id            String   @id @db.Uuid
  atendimentoId String   @map("atendimento_id") @db.Uuid
  interacaoId   String   @unique @map("interacao_id") @db.Uuid
  atendenteId   String   @map("atendente_id") @db.Uuid
  viaIa         Boolean  @default(false) @map("via_ia")
  criadoEm      DateTime @default(now()) @map("criado_em") @db.Timestamptz(6)

  atendimento Atendimento @relation(fields: [atendimentoId], references: [id], onDelete: Cascade)
  interacao   Interacao   @relation(fields: [interacaoId], references: [id], onDelete: Cascade)
  atendente   Usuario     @relation(fields: [atendenteId], references: [id], onDelete: Restrict)

  // Append-only — sem PATCH/DELETE (histórico de 1ª classe, FR-012/FR-013).
  @@index([atendimentoId, criadoEm])
  @@map("resposta_atendimento")
}
