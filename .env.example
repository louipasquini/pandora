# ============================================================================
# Projeto Pandora — variáveis de ambiente (spec 001)
# Copie para .env e ajuste. NUNCA versione o .env real (ver .gitignore).
# Fonte de verdade tipada: backend/src/config/env.schema.ts
# ============================================================================

# --- Runtime ---------------------------------------------------------------
NODE_ENV=development
# Porta do backend NestJS. Padrão 3001 (evita 3000). Configurável.
PORT=3001
# Porta do frontend Vite. Padrão 5174 (evita 5173). Lida pelo frontend.
VITE_PORT=5174

# --- Banco de dados ------------------------------------------------------
# Postgres de desenvolvimento (Compose expõe em 55432). Aponte para outro se quiser.
DATABASE_URL=postgres://pandora:pandora@localhost:55432/pandora
# Banco usado pela suíte de testes (o harness cria um schema isolado por worker dentro dele).
TEST_DATABASE_URL=postgres://pandora:pandora@localhost:55432/pandora_test

# --- Autenticação de serviço (OBRIGATÓRIAS a partir da spec 003) ---------
# O boot ABORTA nomeando a chave se qualquer uma faltar — em todo NODE_ENV.
SERVICE_JWT_SECRET=troque-isto-na-003-com-pelo-menos-32-caracteres
SERVICE_CLIENT_ID=pandora-panel
SERVICE_CLIENT_SECRET=troque-isto-na-003-min-16-chars
# TTL do token de acesso: <n>[s|m|h|d]. Default 12h; teto rígido de 24h.
SERVICE_JWT_TTL=12h
# Origem única do painel autorizada por CORS (default abaixo).
CORS_ORIGIN=http://localhost:5174
# Rate limiting leve de POST /auth/token (janela fixa por IP).
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=10

# --- Worker de ingestão (spec 006) --------------------------------------
# Laço de fundo que processa `evento_origem` pendentes em etapas. Configurável.
INGESTAO_WORKER_ENABLED=true
INGESTAO_WORKER_INTERVALO_MS=5000
INGESTAO_WORKER_MAX_TENTATIVAS=3
INGESTAO_WORKER_LOTE=50
# Base da API que o painel consome (lido pelo frontend via import.meta.env).
VITE_API_BASE_URL=http://localhost:3001

# ============================================================================
# Contas de origem — 7 contas em 4 plataformas.
# Todas OPCIONAIS na spec 001 (as specs de adapter, Fase 2, tornam obrigatórias
# por conta). Presentes aqui para fixar a grafia canônica das chaves.
# Mapa nome-humano -> prefixo: ver docs/001-bootstrap-projeto.md
# ============================================================================

# --- Conta: TMB (TMB Educação) ---
TMB_API_BASE_URL=https://api.exemplo.invalido/tmb
TMB_API_KEY=placeholder
TMB_WEBHOOK_TOKEN=placeholder

# --- Conta: Asaas PRD ---
ASAAS_PRD_API_BASE_URL=https://api.exemplo.invalido/asaas-prd
ASAAS_PRD_API_KEY=placeholder
ASAAS_PRD_WEBHOOK_TOKEN=placeholder

# --- Conta: Asaas SVC ---
ASAAS_SVC_API_BASE_URL=https://api.exemplo.invalido/asaas-svc
ASAAS_SVC_API_KEY=placeholder
ASAAS_SVC_WEBHOOK_TOKEN=placeholder

# --- Conta: Guru PRD ---
GURU_PRD_API_BASE_URL=https://api.exemplo.invalido/guru-prd
GURU_PRD_API_KEY=placeholder
GURU_PRD_WEBHOOK_TOKEN=placeholder

# --- Conta: Guru SVC ---
GURU_SVC_API_BASE_URL=https://api.exemplo.invalido/guru-svc
GURU_SVC_API_KEY=placeholder
GURU_SVC_WEBHOOK_TOKEN=placeholder

