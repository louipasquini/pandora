# ============================================================================
# Projeto Pandora — variáveis de ambiente (spec 001)
# Copie para .env e ajuste. NUNCA versione o .env real (ver .gitignore).
# Fonte de verdade tipada: backend/src/config/env.schema.ts
# ============================================================================

# --- Runtime ---------------------------------------------------------------
NODE_ENV=development
# Porta do backend NestJS. Padrão 3001 (evita 3000). Configurável.
PORT=3001
# Porta do frontend Vite. Padrão 5174 (evita 5173). Lida pelo frontend.
VITE_PORT=5174

# --- Banco de dados ------------------------------------------------------
# Postgres de desenvolvimento (Compose expõe em 55432). Aponte para outro se quiser.
DATABASE_URL=postgres://pandora:pandora@localhost:55432/pandora
# Banco usado pela suíte de testes (o harness cria um schema isolado por worker dentro dele).
TEST_DATABASE_URL=postgres://pandora:pandora@localhost:55432/pandora_test

# --- Autenticação de serviço (OBRIGATÓRIAS a partir da spec 003) ---------
# O boot ABORTA nomeando a chave se qualquer uma faltar — em todo NODE_ENV.
SERVICE_JWT_SECRET=troque-isto-na-003-com-pelo-menos-32-caracteres
SERVICE_CLIENT_ID=pandora-panel
SERVICE_CLIENT_SECRET=troque-isto-na-003-min-16-chars
# TTL do token de acesso: <n>[s|m|h|d]. Default 12h; teto rígido de 24h.
SERVICE_JWT_TTL=12h
# Origem única do painel autorizada por CORS (default abaixo).
CORS_ORIGIN=http://localhost:5174
# Rate limiting leve de POST /auth/token (janela fixa por IP).
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=10

# --- Worker de ingestão (spec 006) --------------------------------------
# Laço de fundo que processa `evento_origem` pendentes em etapas. Configurável.
INGESTAO_WORKER_ENABLED=true
INGESTAO_WORKER_INTERVALO_MS=5000
INGESTAO_WORKER_MAX_TENTATIVAS=3
INGESTAO_WORKER_LOTE=50

# --- Administração do CRM (spec 007) -----------------------------------
# Chave de cifra em repouso do segredo de `integracao` (base64 de 32 bytes,
# AES-256-GCM). OBRIGATÓRIA em todo NODE_ENV — o boot aborta sem ela.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
CRM_INTEGRACAO_CIFRA_KEY=5+QVNu/w2yAj7wkHW4Kq+6bG9v3RE3+rurMCorQFnR0=

# --- Worker do Workflow do CRM (spec 014) -------------------------------
# Laço de fundo que reage a gatilhos internos (lead criado, tag aplicada, etc.).
# Configurável; sem segredo.
CRM_WORKFLOW_WORKER_ENABLED=true
CRM_WORKFLOW_WORKER_INTERVALO_MS=15000
CRM_WORKFLOW_WORKER_LOTE=50

# --- Worker de Disparos do CRM (spec 015) -------------------------------
# Laço de fundo que materializa disparos agendados e envia mensagens em lote —
# o próprio ritmo (intervalo × lote) é o throttling. Configurável; sem segredo.
CRM_DISPAROS_WORKER_ENABLED=true
CRM_DISPAROS_WORKER_INTERVALO_MS=5000
CRM_DISPAROS_WORKER_LOTE=20
CRM_DISPAROS_WORKER_MAX_TENTATIVAS=3

# Base da API que o painel consome (lido pelo frontend via import.meta.env).
VITE_API_BASE_URL=http://localhost:3001

# ============================================================================
# Contas de origem — 7 contas em 4 plataformas.
# Todas OPCIONAIS na spec 001 (as specs de adapter, Fase 2, tornam obrigatórias
# por conta). Presentes aqui para fixar a grafia canônica das chaves.
# Mapa nome-humano -> prefixo: ver docs/001-bootstrap-projeto.md
# ============================================================================

# --- Conta: TMB (TMB Educação) ---
# spec 019: BASE_URL + API_KEY (Bearer) usados por POST /ingestao/tmb/sincronizar
# (GET /api/pedidos); WEBHOOK_TOKEN valida POST /webhooks/tmb/{vendas,financeiro}.
# Sem BASE_URL/API_KEY, o /sincronizar responde 422 (não 500).
TMB_API_BASE_URL=https://api.exemplo.invalido/tmb
TMB_API_KEY=placeholder
TMB_WEBHOOK_TOKEN=placeholder

# --- Contas: Asaas PRD / Asaas SVC ---
# spec 020: API_KEY (header `access_token`, NÃO Bearer) usado por
# POST /ingestao/asaas/sincronizar { conta } (GET /v3/payments, offset/limit);
# BASE_URL default https://api.asaas.com/v3 quando ausente (sandbox = config);
# WEBHOOK_TOKEN valida POST /webhooks/asaas/{prd,svc} (header `asaas-access-token`).
# Sem API_KEY da conta, o /sincronizar daquela conta responde 422 (não 500).
ASAAS_PRD_API_BASE_URL=https://api.exemplo.invalido/asaas-prd
ASAAS_PRD_API_KEY=placeholder
ASAAS_PRD_WEBHOOK_TOKEN=placeholder

ASAAS_SVC_API_BASE_URL=https://api.exemplo.invalido/asaas-svc
ASAAS_SVC_API_KEY=placeholder
ASAAS_SVC_WEBHOOK_TOKEN=placeholder

# --- Contas: Guru PRD / Guru SVC ---
# spec 021: API_KEY (Account Token, header `Authorization: Bearer`) usado por
# POST /ingestao/guru/sincronizar { conta, dataInicio, dataFinal } (GET
# /api/v2/transactions, paginação por cursor, janela ≤ 180 dias);
# BASE_URL default https://digitalmanager.guru/api/v2 quando ausente;
# WEBHOOK_TOKEN valida POST /webhooks/guru/{prd,svc} — a Guru envia o token no
# campo `api_token` do CORPO do JSON (não em header). Sem API_KEY da conta, o
# /sincronizar daquela conta responde 422 (não 500).
GURU_PRD_API_BASE_URL=https://api.exemplo.invalido/guru-prd
GURU_PRD_API_KEY=placeholder
GURU_PRD_WEBHOOK_TOKEN=placeholder

GURU_SVC_API_BASE_URL=https://api.exemplo.invalido/guru-svc
GURU_SVC_API_KEY=placeholder
GURU_SVC_WEBHOOK_TOKEN=placeholder

# --- Conta: Hotmart PRD/SVC (spec 022) ---
# OAuth2 client_credentials: HOTMART_<conta>_API_KEY guarda o token *Basic*
# (entregue no painel do dev); CLIENT_ID/CLIENT_SECRET são o par de credenciais.
# API_BASE_URL default https://developers.hotmart.com/payments/api/v1 quando
# ausente (base OAuth https://api-sec-vlc.hotmart.com é fixa). Sem CLIENT_ID/
# CLIENT_SECRET/API_KEY da conta, POST /ingestao/hotmart/sincronizar responde 422.
# A Hotmart NÃO tem webhook na v1: WEBHOOK_TOKEN guarda o `hottok` da conta, usado
# só quando HOTMART_WEBHOOK_ENABLED=true (senão POST /webhooks/hotmart/* → 503).
HOTMART_PRD_API_BASE_URL=https://api.exemplo.invalido/hotmart-prd
HOTMART_PRD_API_KEY=placeholder
HOTMART_PRD_WEBHOOK_TOKEN=placeholder
HOTMART_PRD_CLIENT_ID=placeholder
HOTMART_PRD_CLIENT_SECRET=placeholder

HOTMART_SVC_API_BASE_URL=https://api.exemplo.invalido/hotmart-svc
HOTMART_SVC_API_KEY=placeholder
HOTMART_SVC_WEBHOOK_TOKEN=placeholder
HOTMART_SVC_CLIENT_ID=placeholder
HOTMART_SVC_CLIENT_SECRET=placeholder

# Liga as rotas de webhook da Hotmart (stub — feature futura). Default false.
HOTMART_WEBHOOK_ENABLED=false
